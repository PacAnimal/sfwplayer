<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SfwPlayer.MainWindow"
        Title="SfwPlayer"
        WindowDecorations="None"
        Background="Black"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        Width="480" Height="270"
        MinWidth="240" MinHeight="135"
        CanResize="True">

    <Grid>
        <Grid.ContextMenu>
            <ContextMenu x:Name="AppMenu">
                <MenuItem x:Name="SelectPlaylistMenuItem" Header="Select Playlist..." Click="OnSelectPlaylistMenuClicked" />
                <Separator />
                <MenuItem x:Name="PrevMenuItem" Header="Previous" Click="OnPrevClicked" IsEnabled="False" />
                <MenuItem x:Name="NextMenuItem" Header="Next" Click="OnNextClicked" IsEnabled="False" />
                <Separator />
                <MenuItem x:Name="SignOutMenuItem" Header="Sign out from YouTube" Click="OnSignOutMenuClicked" />
                <MenuItem x:Name="SaveTestCredentialsMenuItem" Header="Save Test Cookies" Click="OnSaveTestCredentialsClicked" IsVisible="False" />
            </ContextMenu>
        </Grid.ContextMenu>
        <!-- video surface — inside Skia, scales with window, no hit-test -->
        <Image x:Name="VideoImage" Stretch="Uniform" IsHitTestVisible="False" />

        <!-- full-window drag surface, behind everything -->
        <Border Background="Transparent"
                PointerPressed="OnVideoDragPressed"
                PointerMoved="OnVideoPointerMoved"
                PointerReleased="OnVideoDragReleased" />

        <!-- cornerbutton toggle — top-left, fades in on hover -->
        <Button x:Name="PadlockButton"
                ZIndex="10"
                Classes="videobutton"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="4.5,4.5,0,0"
                Opacity="0"
                Click="OnPadlockClicked">
            <Viewbox Width="16" Height="16">
                <Grid Width="24" Height="24">
                    <Grid x:Name="LockClosedIcon">
                        <Path Stroke="#CC000000" StrokeThickness="4"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              Data="M16.5 10.5V6.75C16.5 4.26472 14.4853 2.25 12 2.25C9.51472 2.25 7.5 4.26472 7.5 6.75V10.5M6.75 21.75H17.25C18.4926 21.75 19.5 20.7426 19.5 19.5V12.75C19.5 11.5074 18.4926 10.5 17.25 10.5H6.75C5.50736 10.5 4.5 11.5074 4.5 12.75V19.5C4.5 20.7426 5.50736 21.75 6.75 21.75Z" />
                        <Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              Data="M16.5 10.5V6.75C16.5 4.26472 14.4853 2.25 12 2.25C9.51472 2.25 7.5 4.26472 7.5 6.75V10.5M6.75 21.75H17.25C18.4926 21.75 19.5 20.7426 19.5 19.5V12.75C19.5 11.5074 18.4926 10.5 17.25 10.5H6.75C5.50736 10.5 4.5 11.5074 4.5 12.75V19.5C4.5 20.7426 5.50736 21.75 6.75 21.75Z" />
                    </Grid>
                    <Grid x:Name="LockOpenIcon" IsVisible="False">
                        <Path Stroke="#CC000000" StrokeThickness="4"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              Data="M13.5 10.5V6.75C13.5 4.26472 15.5147 2.25 18 2.25C20.4853 2.25 22.5 4.26472 22.5 6.75V10.5M3.75 21.75H14.25C15.4926 21.75 16.5 20.7426 16.5 19.5V12.75C16.5 11.5074 15.4926 10.5 14.25 10.5H3.75C2.50736 10.5 1.5 11.5074 1.5 12.75V19.5C1.5 20.7426 2.50736 21.75 3.75 21.75Z" />
                        <Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              Data="M13.5 10.5V6.75C13.5 4.26472 15.5147 2.25 18 2.25C20.4853 2.25 22.5 4.26472 22.5 6.75V10.5M3.75 21.75H14.25C15.4926 21.75 16.5 20.7426 16.5 19.5V12.75C16.5 11.5074 15.4926 10.5 14.25 10.5H3.75C2.50736 10.5 1.5 11.5074 1.5 12.75V19.5C1.5 20.7426 2.50736 21.75 3.75 21.75Z" />
                    </Grid>
                </Grid>
            </Viewbox>
        </Button>

        <!-- idle hint / loading indicator; offset upward to clear the centered play button -->
        <TextBlock x:Name="LoadingLabel"
                   Text="Right-click to select media"
                   Foreground="#80FFFFFF"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

        <!-- controls — hidden until hover, fades in/out -->
        <Grid x:Name="ControlsGrid" Opacity="0" IsHitTestVisible="False">

            <!-- resize border highlight -->
            <Border ZIndex="5" BorderBrush="#50FFFFFF" BorderThickness="3" Background="Transparent" IsHitTestVisible="False" />

            <!-- top bar: full-width drag area with optional track title -->
            <Border VerticalAlignment="Top" Height="26" Background="#CC000000"
                    PointerPressed="OnDragPressed">
                <TextBlock x:Name="TrackTitle"
                           Foreground="#80FFFFFF" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"
                           IsVisible="False"
                           Margin="28,0" />
            </Border>

            <!-- close button: top-right, mirrors the cornerbutton -->
            <Button Classes="videobutton"
                    ZIndex="10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,4.5,4.5,0"
                    Click="OnCloseClicked">
                <Viewbox Width="16" Height="16">
                    <Grid Width="24" Height="24">
                        <Path Stroke="#CC000000" StrokeThickness="4"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              Data="M6 18L18 6M6 6l12 12" />
                        <Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              Data="M6 18L18 6M6 6l12 12" />
                    </Grid>
                </Viewbox>
            </Button>

            <!-- bottom bar: seek + controls -->
            <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="7,4,7,5">
                <StackPanel Spacing="2">
                    <Slider x:Name="SeekBar"
                            Minimum="0" Maximum="1"
                            SmallChange="0.01" LargeChange="0.05"
                            Theme="{StaticResource ThinSlider}" />
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,10,Auto,Auto">
                        <TextBlock x:Name="TimeLabel"
                                   Grid.Column="0" Classes="label"
                                   VerticalAlignment="Bottom"
                                   Text="0:00 / 0:00" Margin="0,0,0,2" />
                        <!-- opacity icon: half-filled circle -->
                        <Viewbox Grid.Column="2" Width="12" Height="12"
                                 VerticalAlignment="Center" Margin="0,0,2,0">
                            <Grid Width="24" Height="24">
                                <Ellipse Width="18" Height="18"
                                         Stroke="White" StrokeThickness="2"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path Fill="White"
                                      Data="M12 3 L12 21 A9 9 0 0 1 12 3 Z" />
                            </Grid>
                        </Viewbox>
                        <Slider x:Name="OpacitySlider"
                                Grid.Column="3" Width="58"
                                Minimum="0.1" Maximum="1.0" Value="1.0"
                                SmallChange="0.05"
                                Theme="{StaticResource ThinSlider}" />
                        <Button x:Name="MuteButton"
                                Grid.Column="5" Classes="ctrl"
                                Click="OnMuteClicked">
                            <Viewbox Width="13" Height="13">
                                <Grid Width="24" Height="24">
                                    <Path x:Name="VolumeIcon"
                                          Stroke="White" StrokeThickness="1.5"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          Data="M19.114 5.636a9 9 0 0 1 0 12.728M16.463 8.288a5.25 5.25 0 0 1 0 7.424M6.75 8.25l4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 0 1 2.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z" />
                                    <Path x:Name="MuteIcon"
                                          Stroke="White" StrokeThickness="1.5"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          IsVisible="False"
                                          Data="M17.25 9.75L19.5 12m0 0l2.25 2.25M19.5 12l2.25-2.25M19.5 12l-2.25 2.25m-10.5-6l4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.009 9.009 0 0 1 2.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z" />
                                </Grid>
                            </Viewbox>
                        </Button>
                        <Slider x:Name="VolumeSlider"
                                Grid.Column="6" Width="58"
                                Minimum="0" Maximum="150" Value="80"
                                Theme="{StaticResource ThinSlider}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- prev: left side, vertically centered -->
            <Button x:Name="PrevButton"
                    Classes="videobutton"
                    ZIndex="10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="16,0,0,0"
                    IsEnabled="False"
                    Click="OnPrevClicked">
                <Viewbox Width="32" Height="32">
                    <Grid Width="24" Height="24">
                        <Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              Data="M15.75 19.5L8.25 12l7.5-7.5" />
                    </Grid>
                </Viewbox>
            </Button>

            <!-- play/pause: centered in video -->
            <Button x:Name="PlayPauseButton"
                    Classes="videobutton"
                    ZIndex="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="OnPlayPauseClicked">
                <Viewbox Width="44" Height="44">
                    <Grid Width="24" Height="24">
                        <Path x:Name="PlayIcon"
                              Fill="{Binding $parent[Button].Foreground}"
                              Data="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347c-.75.412-1.667-.13-1.667-.986V5.653z" />
                        <Path x:Name="PauseIcon"
                              Fill="{Binding $parent[Button].Foreground}"
                              IsVisible="False"
                              Data="M6 4.5 H10.5 V19.5 H6 Z M13.5 4.5 H18 V19.5 H13.5 Z" />
                    </Grid>
                </Viewbox>
            </Button>

            <!-- next: right side, vertically centered -->
            <Button x:Name="NextButton"
                    Classes="videobutton"
                    ZIndex="10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,16,0"
                    IsEnabled="False"
                    Click="OnNextClicked">
                <Viewbox Width="32" Height="32">
                    <Grid Width="24" Height="24">
                        <Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              Data="M8.25 4.5l7.5 7.5-7.5 7.5" />
                    </Grid>
                </Viewbox>
            </Button>
        </Grid>

        <!-- resize handles — ZIndex=20 wins over cornerbutton (10) and controls, hidden until hover -->
        <Grid x:Name="ResizeHandles" ZIndex="20" IsVisible="False">
            <!-- NW: L-shaped — horizontal arm along top, vertical arm down left -->
            <Rectangle Width="30" Height="4.5" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Fill="Transparent" Cursor="TopLeftCorner"
                       Tag="NorthWest" PointerPressed="OnResizePressed" />
            <Rectangle Width="4.5" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Fill="Transparent" Cursor="TopLeftCorner"
                       Tag="NorthWest" PointerPressed="OnResizePressed" />
            <!-- NE: L-shaped — horizontal arm along top, vertical arm down right -->
            <Rectangle Width="30" Height="4.5" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Fill="Transparent" Cursor="TopRightCorner"
                       Tag="NorthEast" PointerPressed="OnResizePressed" />
            <Rectangle Width="4.5" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Fill="Transparent" Cursor="TopRightCorner"
                       Tag="NorthEast" PointerPressed="OnResizePressed" />
            <!-- SW: L-shaped — vertical arm up left, horizontal arm along bottom -->
            <Rectangle Width="4.5" Height="30" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Fill="Transparent" Cursor="BottomLeftCorner"
                       Tag="SouthWest" PointerPressed="OnResizePressed" />
            <Rectangle Width="30" Height="4.5" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Fill="Transparent" Cursor="BottomLeftCorner"
                       Tag="SouthWest" PointerPressed="OnResizePressed" />
            <!-- SE: L-shaped — vertical arm up right, horizontal arm along bottom -->
            <Rectangle Width="4.5" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Fill="Transparent" Cursor="BottomRightCorner"
                       Tag="SouthEast" PointerPressed="OnResizePressed" />
            <Rectangle Width="30" Height="4.5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Fill="Transparent" Cursor="BottomRightCorner"
                       Tag="SouthEast" PointerPressed="OnResizePressed" />
            <Rectangle Height="4.5"
                       HorizontalAlignment="Stretch" VerticalAlignment="Top"
                       Margin="30,0" Fill="Transparent" Cursor="SizeNorthSouth"
                       Tag="North" PointerPressed="OnResizePressed" />
            <Rectangle Height="4.5"
                       HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                       Margin="30,0" Fill="Transparent" Cursor="SizeNorthSouth"
                       Tag="South" PointerPressed="OnResizePressed" />
            <Rectangle Width="4.5"
                       VerticalAlignment="Stretch" HorizontalAlignment="Left"
                       Margin="0,30" Fill="Transparent" Cursor="SizeWestEast"
                       Tag="West" PointerPressed="OnResizePressed" />
            <Rectangle Width="4.5"
                       VerticalAlignment="Stretch" HorizontalAlignment="Right"
                       Margin="0,30" Fill="Transparent" Cursor="SizeWestEast"
                       Tag="East" PointerPressed="OnResizePressed" />
        </Grid>
    </Grid>

</Window>
